# ========== 前端 (client) ==========
# 本地开发时可留空（走 vite.config.ts 的 proxy）
# 若前端和后端分离部署，填后端完整地址，例如：
# VITE_API_BASE=https://my-backend.onrender.com/api
# Socket.io WebSocket 完整地址，例如：
# VITE_SOCKET_URL=https://my-backend.onrender.com

# ========== 后端 (server) ==========
# 数据库
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=your_db_password
DB_NAME=zhihui_zhulao

# JWT
JWT_SECRET=your_jwt_secret_key

# Redis (可选)
REDIS_HOST=localhost
REDIS_PORT=6379

# 服务端口
PORT=5000
